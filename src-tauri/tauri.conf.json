{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "werkbyte Campus",
  "version": "0.1.0",
  "identifier": "de.werkbyte.campus",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "werkbyte Campus",
        "width": 1400,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "dragDropEnabled": true,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "worker-src": "'self' blob:",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' blob: data:",
        "font-src": "'self' blob: data:",
        "connect-src": "ipc: http://ipc.localhost 'self' blob: data:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "freezePrototype": false,
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline' 'wasm-unsafe-eval'",
        "worker-src": "'self' blob:",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' blob: data:",
        "font-src": "'self' blob: data:",
        "connect-src": "ipc: http://ipc.localhost 'self' blob: data: ws://localhost:1420 http://localhost:1420",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      }
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "werkbyte",
    "category": "Education",
    "shortDescription": "Studienunterlagen lokal organisieren, annotieren und als PDF exportieren",
    "copyright": "© werkbyte",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "German",
          "English"
        ],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": [
          "de-DE"
        ]
      }
    }
  }
}