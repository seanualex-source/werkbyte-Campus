{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Minimal benötigte Rechte des Hauptfensters: eigene Campus-Befehle, Ereignisse und Fenstersteuerung. Kein Dateisystem-, Shell- oder HTTP-Zugriff aus der Oberfläche.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:default",
    "core:window:default",
    "core:window:allow-destroy",
    "core:window:allow-set-title",
    "core:app:default",
    "allow-app-info",
    "allow-library-choose-location",
    "allow-library-retry",
    "allow-folder-list",
    "allow-folder-create",
    "allow-folder-rename",
    "allow-folder-move",
    "allow-folder-trash",
    "allow-document-list",
    "allow-document-create-note",
    "allow-document-rename",
    "allow-document-move",
    "allow-document-trash",
    "allow-document-load",
    "allow-document-apply",
    "allow-document-compose",
    "allow-document-set-view",
    "allow-trash-list",
    "allow-trash-summary",
    "allow-trash-restore",
    "allow-trash-purge",
    "allow-trash-empty",
    "allow-import-pick",
    "allow-import-staged-read",
    "allow-import-commit",
    "allow-import-discard",
    "allow-blob-read",
    "allow-image-pick",
    "allow-export-pick-target",
    "allow-export-prepare",
    "allow-export-finish",
    "allow-export-cancel",
    "allow-backup-status",
    "allow-backup-choose-target",
    "allow-backup-create",
    "allow-backup-verify-pick",
    "allow-backup-restore-pick",
    "allow-maintenance-gc"
  ]
}