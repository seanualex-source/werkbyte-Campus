{
  "name": "werkbyte-campus",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "werkbyte Campus: lokale Windows-App zum Organisieren, Annotieren und Exportieren von Studienunterlagen",
  "scripts": {
    "assets": "node scripts/copy-pdfjs-assets.mjs",
    "dev": "npm run assets && vite",
    "build": "npm run assets && tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "@tauri-apps/api": "2.12.4",
    "lucide-react": "*",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "perfect-freehand": "1.2.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@napi-rs/canvas": "1.1.0",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "*",
    "@types/react": "19.3.0",
    "@types/react-dom": "*",
    "@vitejs/plugin-react": "6.2.1",
    "dejavu-fonts-ttf": "2.37.3",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
